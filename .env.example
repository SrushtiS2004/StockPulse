# StockPulse Environment Configuration Example
# Copy this file to .env or set environment variables in your deployment environment:
#
# On Linux/macOS:
#   export LLM_API_KEY="sk-SfyNGxhcv7RnQKbZFWX2LQ"
#   export LLM_COOKIE="6bf6da0e46dc446bd58693d49c303e18=f3f865650f0f8f3b30731936b2eb5857"
#
# On Windows PowerShell:
#   $env:LLM_API_KEY="sk-SfyNGxhcv7RnQKbZFWX2LQ"
#   $env:LLM_COOKIE="6bf6da0e46dc446bd58693d49c303e18=f3f865650f0f8f3b30731936b2eb5857"

LLM_PROVIDER=zycus
LLM_BASE_URL=https://litellm-qc.zycus.net/v1
LLM_API_KEY=your_litellm_api_key_here
LLM_MODEL=qwen-cursor
LLM_PRODUCT_HEADER=PC1
LLM_COOKIE=your_zycus_session_cookie_here
COMMERCE_STRATEGY=ai
